{
  "name": "opencode-flow-panel",
  "version": "0.3.1",
  "private": true,
  "description": "OpenCode plugin that visualizes an agent's work as a live flowchart panel (OpenCode + Pi / oh-my-pi)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    "./server": "./src/server.ts",
    "./extension": "./src/extension.ts",
    "./mcp": "./src/mcp.ts"
  },
  "pi": {
    "extensions": [
      "./dist/pi/extension.js",
      "./src/extension.ts"
    ]
  },
  "omp": {
    "extensions": [
      "./dist/pi/extension.js",
      "./src/extension.ts"
    ]
  },
  "scripts": {
    "build": "npm run build:opencode && npm run build:pi && npm run build:claude",
    "build:opencode": "esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/opencode/server.js",
    "build:pi": "esbuild src/extension.ts --bundle --platform=node --format=esm --outfile=dist/pi/extension.js --external:@earendil-works/* --external:@oh-my-pi/*",
    "build:claude": "esbuild src/mcp.ts --bundle --platform=node --format=esm --outfile=dist/claude/mcp.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test \"src/**/*.test.ts\"",
    "panel:fixture": "node scripts/render-fixture.ts"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.16",
    "typebox": "npm:@sinclair/typebox@^0.34.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@eslint/js": "^9.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
