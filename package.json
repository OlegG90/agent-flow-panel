{
  "name": "opencode-flow-panel",
  "version": "0.1.0",
  "private": true,
  "description": "OpenCode plugin that visualizes an agent's work as a live flowchart panel",
  "type": "module",
  "exports": {
    "./server": "./src/server.ts"
  },
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test \"src/**/*.test.ts\"",
    "panel:fixture": "node scripts/render-fixture.ts"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
